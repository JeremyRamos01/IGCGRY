rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "iglesiaevangelicacasagranrey@gmail.com" || 
        request.auth.token.email == "ramosjeremy023@gmail.com"
      );
    }

    // Reglas para imágenes de eventos / volantes
    match /flyers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /eventos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para imágenes de posts / noticias
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /noticias/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla general de seguridad por defecto (Cero brechas: solo administradores pueden escribir)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
